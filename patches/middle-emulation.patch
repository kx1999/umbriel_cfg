From fe9707b28aacf199c8f2d860672dfa08a0f5f52a Mon Sep 17 00:00:00 2001
From: kylex <kyle@ultra.tech>
Date: Sat, 7 Nov 2026 00:52:52 -0500
Subject: [PATCH] feat(input): add middle_emulation option for mice, touchpads
 and devices

Exposes libinput middle-button emulation (left+right press = middle click)
as input.mouse.middle_emulation, input.touchpad.middle_emulation and
input.device middle_emulation. Unset keeps the libinput default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/user/input.md           |  3 +++
 src/config/config.h          |  4 ++++
 src/config/fields_input.cpp  |  3 +++
 src/server/server_events.cpp | 37 ++++++++++++++++++++++++++++++++++++
 tests/unit/config_load.cpp   |  5 +++++
 5 files changed, 52 insertions(+)

diff --git a/docs/user/input.md b/docs/user/input.md
index 472a5fd7..98a9093b 100644
--- a/docs/user/input.md
+++ b/docs/user/input.md
@@ -180,8 +180,11 @@ sensitivity = 0.0
 scroll_wheel_step = 60
 # scroll_button = "MouseBack"
 # scroll_button_lock = false
+# middle_emulation = true
 ```
 
+`middle_emulation = true` sends a middle click when the left and right buttons are pressed together, for mice without a usable middle button. The key is also accepted in `[input.touchpad]` and `[[input.device]]`; omit it to preserve the device default.
+
 `sensitivity` ranges from -1.0 to 1.0. `scroll_wheel_step` accepts 1 to 1000 logical pixels per layout-scroll action. `left_handed` swaps the primary and secondary buttons; omit it to preserve the device default.
 
 Omitting `accel_profile` preserves the device default. A custom libinput curve uses this form:
diff --git a/src/config/config.h b/src/config/config.h
index 5a507a51..d1f870ef 100644
--- a/src/config/config.h
+++ b/src/config/config.h
@@ -1170,6 +1170,7 @@ namespace umbriel {
         std::optional<ScrollMethod> scrollMethod;
         std::optional<ClickMethod> clickMethod;
         std::optional<TapButtonMap> tapButtonMap;
+        std::optional<bool> middleEmulation;
         bool operator==(const Touchpad&) const = default;
       } touchpad;
 
@@ -1182,6 +1183,8 @@ namespace umbriel {
         std::optional<uint32_t> scrollButton;
         // One press latches scrolling on, the next releases it, instead of requiring a hold.
         std::optional<bool> scrollButtonLock;
+        // Pressing left and right together sends a middle click. Unset leaves the libinput default.
+        std::optional<bool> middleEmulation;
         double sensitivity = 0.0;
         int scrollWheelStep = 60;
         bool operator==(const Mouse&) const = default;
@@ -1258,6 +1261,7 @@ namespace umbriel {
         std::optional<TapButtonMap> tapButtonMap;
         std::optional<uint32_t> scrollButton;
         std::optional<bool> scrollButtonLock;
+        std::optional<bool> middleEmulation;
         bool operator==(const Device&) const = default;
       };
 
diff --git a/src/config/fields_input.cpp b/src/config/fields_input.cpp
index 47ba4790..d1544ba0 100644
--- a/src/config/fields_input.cpp
+++ b/src/config/fields_input.cpp
@@ -306,6 +306,7 @@ namespace umbriel {
           choice("scroll_method", &In::Touchpad::scrollMethod, scrollMethods, Case::Fold),
           choice("click_method", &In::Touchpad::clickMethod, clickMethods, Case::Fold),
           choice("tap_button_map", &In::Touchpad::tapButtonMap, tapButtonMaps, Case::Fold),
+          boolean("middle_emulation", &In::Touchpad::middleEmulation),
       };
       static const Fields<In::Mouse> mouse{
           boolean("natural_scroll", &In::Mouse::naturalScroll),
@@ -313,6 +314,7 @@ namespace umbriel {
           real("sensitivity", -1.0, 1.0, &In::Mouse::sensitivity),
           integer("scroll_wheel_step", 1, 1000, &In::Mouse::scrollWheelStep),
           boolean("scroll_button_lock", &In::Mouse::scrollButtonLock),
+          boolean("middle_emulation", &In::Mouse::middleEmulation),
           accelProfileField(&In::Mouse::accelProfile),
           choice("scroll_button", &In::Mouse::scrollButton, scrollButtons, Case::Fold),
       };
@@ -383,6 +385,7 @@ namespace umbriel {
           real("sensitivity", -1.0, 1.0, &In::Device::sensitivity),
           boolean("disable_while_typing", &In::Device::disableWhileTyping),
           boolean("scroll_button_lock", &In::Device::scrollButtonLock),
+          boolean("middle_emulation", &In::Device::middleEmulation),
           accelProfileField(&In::Device::accelProfile),
           choice("scroll_method", &In::Device::scrollMethod, scrollMethods, Case::Fold),
           choice("click_method", &In::Device::clickMethod, clickMethods, Case::Fold),
diff --git a/src/server/server_events.cpp b/src/server/server_events.cpp
index e721e517..bccec97c 100644
--- a/src/server/server_events.cpp
+++ b/src/server/server_events.cpp
@@ -292,6 +292,32 @@ namespace umbriel {
       }
     }
 
+    void applyMiddleEmulation(
+        libinput_device* libinputDevice, const wlr_input_device* device, const std::optional<bool>& configured,
+        std::string_view setting
+    ) {
+      if (libinput_device_config_middle_emulation_is_available(libinputDevice) == 0) {
+        if (configured) {
+          kLog.warn("input: '{}' does not support {}", deviceName(device), setting);
+        }
+        return;
+      }
+      const bool enabled = configured.value_or(
+          libinput_device_config_middle_emulation_get_default_enabled(libinputDevice)
+          == LIBINPUT_CONFIG_MIDDLE_EMULATION_ENABLED
+      );
+      const auto state =
+          enabled ? LIBINPUT_CONFIG_MIDDLE_EMULATION_ENABLED : LIBINPUT_CONFIG_MIDDLE_EMULATION_DISABLED;
+      if (libinput_device_config_middle_emulation_set_enabled(libinputDevice, state)
+          != LIBINPUT_CONFIG_STATUS_SUCCESS) {
+        if (configured) {
+          kLog.warn("input: failed to apply {} to '{}'", setting, deviceName(device));
+        } else {
+          kLog.warn("input: failed to restore the default middle-button emulation for '{}'", deviceName(device));
+        }
+      }
+    }
+
     void applyScrollMethod(
         libinput_device* libinputDevice, const wlr_input_device* device, std::optional<ScrollMethod> configured,
         std::string_view setting
@@ -697,6 +723,17 @@ namespace umbriel {
                                                       : "input.mouse.left_handed"
       );
 
+      const bool hasMiddleEmulationOverride = override != nullptr && override->middleEmulation.has_value();
+      const std::optional<bool>& middleEmulation = hasMiddleEmulationOverride ? override->middleEmulation
+          : isTouchpad                                                        ? input.touchpad.middleEmulation
+                                                                              : input.mouse.middleEmulation;
+      applyMiddleEmulation(
+          libinputDevice, device, middleEmulation,
+          hasMiddleEmulationOverride ? "input.device.middle_emulation"
+              : isTouchpad           ? "input.touchpad.middle_emulation"
+                                     : "input.mouse.middle_emulation"
+      );
+
       // Button scrolling has no `[input.touchpad]` counterpart: a touchpad only gets it from its own device rule,
       // never from `[input.mouse]`, since claiming a button there would cost the pad its two-finger scrolling.
       const std::optional<uint32_t> scrollButton = override != nullptr && override->scrollButton
diff --git a/tests/unit/config_load.cpp b/tests/unit/config_load.cpp
index 13217e50..b91ee487 100644
--- a/tests/unit/config_load.cpp
+++ b/tests/unit/config_load.cpp
@@ -2838,6 +2838,7 @@ accel_profile = "custom 0.2 0.0 0.5 1.0 2.0"
 sensitivity = 0.25
 scroll_button = "MouseForward"
 scroll_button_lock = true
+middle_emulation = true
 
 [[input.device]]
 name = "Acme Split Keyboard"
@@ -2867,6 +2868,7 @@ accel_profile = "flat"
 sensitivity = -0.5
 scroll_button = "MouseBack"
 scroll_button_lock = false
+middle_emulation = false
 )");
 
   ConfigStore& store = umbriel::configStore();
@@ -2882,6 +2884,7 @@ scroll_button_lock = false
   CHECK_EQ(input.mouse.sensitivity, 0.25);
   CHECK(input.mouse.scrollButton == std::optional<uint32_t>(BTN_EXTRA));
   CHECK(input.mouse.scrollButtonLock == std::optional<bool>(true));
+  CHECK(input.mouse.middleEmulation == std::optional<bool>(true));
   CHECK(input.mouse.leftHanded == std::optional<bool>(true));
   CHECK(input.touchpad.accelProfile.has_value());
   if (input.touchpad.accelProfile.has_value()) {
@@ -2940,6 +2943,7 @@ scroll_button_lock = false
     CHECK(!mouse->clickMethod.has_value());
     CHECK(mouse->scrollButton == std::optional<uint32_t>(BTN_SIDE));
     CHECK(mouse->scrollButtonLock == std::optional<bool>(false));
+    CHECK(mouse->middleEmulation == std::optional<bool>(false));
     CHECK(!mouse->leftHanded.has_value());
     CHECK(!mouse->enabled.has_value());
   }
@@ -2958,6 +2962,7 @@ UMBRIEL_TEST(mouseScrollButtonDefaultsToUnset) {
   const umbriel::Config defaults;
   CHECK(!defaults.input.mouse.scrollButton.has_value());
   CHECK(!defaults.input.mouse.scrollButtonLock.has_value());
+  CHECK(!defaults.input.mouse.middleEmulation.has_value());
 }
 
 UMBRIEL_TEST(touchpadAccelerationDefaultsToUnset) {
