+local function favoriteInsertionZone(index)
+  return ui.dropZone({
+    key = "favorite-gap-" .. index,
+    accepts = { FAVORITE_DRAG_TYPE },
+    value = tostring(index),
+    onDrop = "onFavoriteDropped",
